<svg width="512" height="512" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1F3F66" />
      <stop offset="1" stop-color="#152C48" />
    </linearGradient>
    <linearGradient id="wood" x1="0.1" y1="0" x2="0.9" y2="1">
      <stop offset="0" stop-color="#E3B278" />
      <stop offset="0.5" stop-color="#B87A3F" />
      <stop offset="1" stop-color="#8B5A2B" />
    </linearGradient>
    <linearGradient id="woodHandle" x1="0" y1="0" x2="1" y2="0.3">
      <stop offset="0" stop-color="#C98A47" />
      <stop offset="1" stop-color="#9C6530" />
    </linearGradient>
    <radialGradient id="sheen" cx="0.35" cy="0.3" r="0.7">
      <stop offset="0" stop-color="#F6DFB6" stop-opacity="0.55" />
      <stop offset="1" stop-color="#F6DFB6" stop-opacity="0" />
    </radialGradient>
  </defs>

  <rect x="0" y="0" width="512" height="512" rx="0" fill="url(#bg)" />

  <!-- Delft-tegel hoekmotief -->
  <rect x="52" y="52" width="34" height="34" rx="6" fill="rgba(255,255,255,0.09)" transform="rotate(45 69 69)" />
  <rect x="426" y="426" width="34" height="34" rx="6" fill="rgba(255,255,255,0.07)" transform="rotate(45 443 443)" />
  <rect x="426" y="52" width="18" height="18" rx="4" fill="rgba(255,255,255,0.06)" transform="rotate(45 435 61)" />

  <g transform="translate(256 256) scale(0.72) translate(-256 -256) rotate(-28 256 256)">
    <!-- zachte stoom -->
    <path d="M150 152 q14 -30 42 -30" stroke="#F6F4EE" stroke-width="10" stroke-linecap="round" fill="none" opacity="0.30" />
    <path d="M182 138 q14 -34 42 -34" stroke="#F6F4EE" stroke-width="10" stroke-linecap="round" fill="none" opacity="0.20" />

    <!-- schaduw onder de lepel -->
    <ellipse cx="182" cy="266" rx="98" ry="76" fill="#0E2038" opacity="0.25" />

    <!-- handvat: taps toelopend hout, van kop naar uiteinde -->
