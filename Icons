    <circle cx="408" cy="253" r="9" fill="#152C48" opacity="0.9" />
    <circle cx="408" cy="253" r="9" fill="none" stroke="#6B4423" stroke-width="2.5" />

    <!-- lepelkop: ovale houten bak -->
    <ellipse cx="176" cy="256" rx="96" ry="70" fill="url(#wood)" stroke="#6B4423" stroke-width="6" />
    <ellipse cx="176" cy="256" rx="80" ry="56" fill="none" stroke="#6B4423" stroke-width="2" opacity="0.3" />
    <!-- houtnerf in de kop -->
    <path d="M108 240 C 150 226, 210 226, 250 244" stroke="#6B4423" stroke-width="2.6" fill="none" opacity="0.3" />
    <path d="M104 268 C 150 284, 212 286, 252 266" stroke="#6B4423" stroke-width="2.6" fill="none" opacity="0.28" />
    <path d="M118 254 C 155 246, 200 246, 236 256" stroke="#6B4423" stroke-width="2" fill="none" opacity="0.22" />
    <!-- glans -->
    <ellipse cx="150" cy="228" rx="46" ry="24" fill="url(#sheen)" />
  </g>
</svg>

